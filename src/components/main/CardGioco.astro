---
import type { CollectionEntry } from 'astro:content';
import Cover from './Cover.astro';
interface Props { gioco: CollectionEntry<'giochi'> }
const { gioco } = Astro.props;
const d = gioco.data;
---

<a class="rz-card rz-card-link" href={`/giochi/${gioco.id}/`}>
  <Cover
    src={d.copertina}
    alt={d.titolo}
    fallback={d.titolo}
    badge={d.stato === 'pubblicato' ? 'Pubblicato' : 'In sviluppo'}
  />
  <div class="rz-card__body">
    <p class="rz-card-meta">{d.sistema} · {d.anno}</p>
    <h3 style="margin: 0 0 0.4rem;">{d.titolo}</h3>
    <p style="margin: 0;">{d.estratto}</p>
  </div>
</a>
