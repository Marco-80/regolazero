---
// Pulsante "triangolo con lucchetto" in alto a destra: login/registrazione
// vera via Netlify Identity (CLAUDE.md §15). Registrazione APERTA a
// chiunque; vedere il sito richiede un ruolo (preview/editor) assegnato a
// mano dall'admin dopo la registrazione.
import { BYPASS_KEY, NETLIFY_IDENTITY_URL, RUOLI_CHE_SBLOCCANO } from '../config/site';

const configurato = Boolean(NETLIFY_IDENTITY_URL);
---

<button type="button" id="rz-login-triangle" aria-label="Accedi o registrati" title="Accedi o registrati" class="rz-corner-badge">
  <img src="/images/site/lucchetto.png" alt="" width="160" height="130" />
</button>

<p id="rz-login-msg" class="rz-login-msg" role="status" aria-live="polite" hidden></p>

{
  configurato && (
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js" />
  )
}

<script define:vars={{ BYPASS_KEY, NETLIFY_IDENTITY_URL, RUOLI_CHE_SBLOCCANO, configurato }}>
  (function () {
    var btn = document.getElementById('rz-login-triangle');
    var msg = document.getElementById('rz-login-msg');
    if (!btn) return;

    function mostraMsg(testo) {
      if (!msg) return;
      msg.textContent = testo;
      msg.hidden = false;
    }

    function sbloccaESiVaAllaHome() {
      try {
        localStorage.setItem(BYPASS_KEY, '1');
      } catch (e) {}
      window.location.href = '/';
    }

    function haRuoloValido(user) {
      var ruoli = (user && user.app_metadata && user.app_metadata.roles) || [];
      return ruoli.some(function (r) {
        return RUOLI_CHE_SBLOCCANO.indexOf(r) !== -1;
      });
    }

    // Chiamata dopo login/init/signup: decide se sbloccare o mostrare
    // "in attesa di approvazione".
    function gestisciUtente(user) {
      if (!user) return;
      if (haRuoloValido(user)) {
        sbloccaESiVaAllaHome();
      } else {
        mostraMsg(
          'Registrazione ricevuta! Il sito è ancora privato: ti avviseremo quando sarà visibile.',
        );
      }
    }

    if (!configurato) {
      btn.addEventListener('click', function () {
        alert(
          'Login non ancora configurato su questo ambiente. Chiedi il link di anteprima a chi gestisce il sito.',
        );
      });
      return;
    }

    function avvia() {
      if (!window.netlifyIdentity) return;
      window.netlifyIdentity.init({ APIUrl: NETLIFY_IDENTITY_URL });

      // sessione già valida da una visita precedente
      window.netlifyIdentity.on('init', gestisciUtente);
      // login riuscito nel modale
      window.netlifyIdentity.on('login', gestisciUtente);
      // registrazione appena fatta (di solito richiede conferma email prima
      // di essere "loggato": il widget lo gestisce da sé)
      window.netlifyIdentity.on('signup', function () {
        mostraMsg('Controlla la posta per confermare la registrazione.');
      });

      btn.addEventListener('click', function () {
        window.netlifyIdentity.open('login'); // il modale ha anche il tab "Sign up"
      });
    }

    // lo script del widget potrebbe non essere ancora pronto
    if (window.netlifyIdentity) avvia();
    else document.addEventListener('DOMContentLoaded', avvia);
  })();
</script>

<style>
  .rz-corner-badge {
    position: fixed;
    top: 0;
    right: 0;
    width: 7.5rem;
    height: 7.5rem;
    padding: 0;
    border: 0;
    cursor: pointer;
    background: #111;
    clip-path: polygon(0 0, 100% 0, 100% 100%);
    display: block;
    z-index: 20;
  }
  .rz-corner-badge::after {
    content: '';
    position: absolute;
    inset: 0;
    /* triangolo bianco inset: crea l'effetto "bordo" sulla sola diagonale
       (il bordo su alto/destra non serve, coincide col taglio della pagina) */
    margin: 0.16rem -0.16rem 0 0.16rem;
    background: #f2f0eb;
    clip-path: polygon(0 0, 100% 0, 100% 100%);
  }
  .rz-corner-badge img {
    position: absolute;
    top: 1.4rem;
    right: 1.5rem;
    width: 2.5rem;
    height: auto;
    z-index: 1;
  }
  .rz-corner-badge:hover,
  .rz-corner-badge:focus-visible {
    filter: brightness(1.08);
  }
  .rz-corner-badge:focus-visible {
    outline: 2px solid #f2f0eb;
    outline-offset: -4px;
  }
  .rz-login-msg {
    position: fixed;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    max-width: 26rem;
    margin: 0;
    padding: 0.75rem 1.1rem;
    background: #1c1c1c;
    border: 1px solid #333;
    border-radius: 8px;
    color: #d8d8d8;
    font-size: 0.9rem;
    text-align: center;
    z-index: 20;
  }
</style>
