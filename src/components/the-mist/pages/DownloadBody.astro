---
import { t } from '../../../i18n/the-mist';
import type { Lingua } from '../../../i18n/the-mist';
// I file scaricabili (PDF, docx, schede stampabili) vanno in
// public/downloads/the-mist/ e vengono elencati qui.
interface Props { lang: Lingua }
const { lang } = Astro.props;
const s = t[lang];
---

<h1>{s.download}</h1>
<p><em>{s.segnaposto}</em> {s.downloadInArrivo}</p>
