---
import { t } from '../../../i18n/the-mist';
import type { Lingua } from '../../../i18n/the-mist';
// Fase 4: generatore di villaggio, generatore di rovine ("Vecchi Ricordi"),
// generatore "Spettro della Nebbia" (emozione del luogo).
// Tabelle come JSON in src/data/, logica di tiro lato client.
interface Props { lang: Lingua }
const { lang } = Astro.props;
const s = t[lang];
---

<h1>{s.generatori}</h1>
<p><em>{s.segnaposto}</em> {s.generatoriInArrivo}</p>
<ul>
  <li>{s.genVillaggio}</li>
  <li>{s.genRovine}</li>
  <li>{s.genSpettro}</li>
</ul>
