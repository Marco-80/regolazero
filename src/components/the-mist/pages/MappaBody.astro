---
import { t } from '../../../i18n/the-mist';
import type { Lingua } from '../../../i18n/the-mist';
// Fase 5: immagine base mappa.png in public/images/the-mist/ + marker overlay
// SVG/HTML cliccabili (Dun-Tara, Zarath, Cadmornagh, Lago di Oen, ...).
interface Props { lang: Lingua }
const { lang } = Astro.props;
const s = t[lang];
---

<h1>{s.mappa}</h1>
<p><em>{s.segnaposto}</em> {s.mappaInArrivo}</p>
