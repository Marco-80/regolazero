---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { urlMist, t } from '../../../i18n/the-mist';
import type { Lingua } from '../../../i18n/the-mist';

interface Props {
  lang: Lingua;
  entry: CollectionEntry<'avventure'>;
}
const { lang, entry } = Astro.props;
const s = t[lang];
const { Content } = await render(entry);
const d = entry.data;
---

<p><a href={urlMist(lang, 'avventure/')}>{s.tornaAvventure}</a></p>

<h1>{d.titolo}</h1>

<p style="color: var(--tm-muted);">
  {s.di} {d.autore}
  {d.giocatori && <> · {d.giocatori} {s.giocatori}</>}
  {d.durata && <> · {d.durata}</>}
</p>

<Content />
