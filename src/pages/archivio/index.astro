---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import Search from 'astro-pagefind/components/Search';
import { articoliPubblicati, hrefArticolo, isPubblicatoContenuto } from '../../lib/articoli';

// Vista aggregata: giochi + articoli + contenuti. Ricerca Pagefind;
// i filtri a faccette interattivi arrivano in Fase 6.
const giochi = await getCollection('giochi');
const articoli = await articoliPubblicati();
const contenuti = await getCollection('contenuti', isPubblicatoContenuto);

const voci = [
  ...giochi.map((g) => ({
    titolo: g.data.titolo,
    tipo: 'gioco',
    meta: `${g.data.sistema} · ${g.data.anno}`,
    href: `/giochi/${g.id}/`,
    estratto: g.data.estratto,
  })),
  ...articoli.map((a) => ({
    titolo: a.data.titolo,
    tipo: `articolo · ${a.data.tipo}`,
    meta: a.data.gioco ?? 'RegolaZero',
    href: hrefArticolo(a),
    estratto: a.data.estratto,
  })),
  ...contenuti.map((c) => ({
    titolo: c.data.titolo,
    tipo: `contenuto · ${c.data.tipo}`,
    meta: c.data.gioco ?? c.data.sistema ?? '—',
    href: c.data.gioco ? `/giochi/${c.data.gioco}/contenuti/${c.id}/` : '/materiali/',
    estratto: c.data.estratto,
  })),
];
---

<MainLayout titolo="Archivio" descrizione="Tutti i contenuti RegolaZero.">
  <h1>Archivio</h1>

  <div data-pagefind-ignore>
    <Search id="ricerca" className="pagefind-ui" uiOptions={{ showImages: false }} />
  </div>

  <ul class="rz-grid" style="list-style: none; padding: 0;">
    {
      voci.map((v) => (
        <li class="rz-card">
          <a href={v.href} style="text-decoration: none; color: inherit;">
            <div class="rz-card__body">
              <p style="color: var(--rz-muted); font-size: 0.8rem; margin: 0 0 0.3rem;">
                {v.tipo} · {v.meta}
              </p>
              <h2 style="margin: 0 0 0.3rem; font-size: 1.1rem;">{v.titolo}</h2>
              <p style="margin: 0;">{v.estratto}</p>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</MainLayout>
