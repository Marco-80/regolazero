---
import { getCollection, render } from 'astro:content';
import ArticoloLayout from '../../../../layouts/ArticoloLayout.astro';
import { isPubblicato } from '../../../../lib/articoli';

export async function getStaticPaths() {
  const articoli = await getCollection('articoli', isPubblicato);
  return articoli
    .filter((a) => a.data.gioco)
    .map((a) => ({
      params: { gioco: a.data.gioco!, slug: a.id },
      props: { articolo: a },
    }));
}

const { articolo } = Astro.props;
const { Content } = await render(articolo);
---

<ArticoloLayout articolo={articolo}>
  <Content />
</ArticoloLayout>
