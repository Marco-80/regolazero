---
import { getCollection, render } from 'astro:content';
import MainLayout from '../../../../layouts/MainLayout.astro';
import { GENERATORI } from '../../../../components/generatori/registry';

export async function getStaticPaths() {
  const generatori = await getCollection('generatori');
  return generatori
    .filter((x) => x.data.gioco)
    .map((x) => ({
      params: { gioco: x.data.gioco!, slug: x.id },
      props: { generatore: x },
    }));
}

const { generatore } = Astro.props;
const d = generatore.data;
const { Content } = await render(generatore);

const Componente = GENERATORI[d.componente] as any;
---

<MainLayout titolo={d.titolo} descrizione={d.estratto}>
  <p><a href={`/giochi/${d.gioco}/generatori/`}>← Generatori</a></p>
  <h1>{d.titolo}</h1>
  <p>{d.estratto}</p>

  {
    Componente ? (
      <Componente />
    ) : (
      <p style="color: var(--rz-muted);">
        <em>Componente "{d.componente}" non registrato in
        src/components/generatori/registry.ts.</em>
      </p>
    )
  }

  <div class="rz-prose" style="margin-top: 2rem;"><Content /></div>
</MainLayout>
