---
import { getCollection } from 'astro:content';
import MainLayout from '../../../../layouts/MainLayout.astro';
import { isPubblicatoContenuto } from '../../../../lib/articoli';

export async function getStaticPaths() {
  const giochi = await getCollection('giochi');
  return giochi.map((g) => ({ params: { gioco: g.id }, props: { gioco: g } }));
}

const { gioco } = Astro.props;
const contenuti = (await getCollection('contenuti', isPubblicatoContenuto)).filter(
  (c) => c.data.gioco === gioco.id,
);
---

<MainLayout titolo={`Contenuti — ${gioco.data.titolo}`}>
  <p><a href={`/giochi/${gioco.id}/`}>← {gioco.data.titolo}</a></p>
  <h1>Contenuti — {gioco.data.titolo}</h1>

  {
    contenuti.length === 0 ? (
      <p><em>Nessun contenuto.</em></p>
    ) : (
      <ul style="list-style: none; padding: 0;">
        {contenuti.map((c) => (
          <li class="rz-card" style="margin-block: 0.75rem;">
            <div class="rz-card__body">
              <p style="color: var(--rz-muted); font-size: 0.8rem; margin: 0 0 0.3rem;">{c.data.tipo}</p>
              <h3 style="margin: 0 0 0.3rem;">{c.data.titolo}</h3>
              <p style="margin: 0 0 0.5rem;">{c.data.estratto}</p>
              {c.data.file && <a href={c.data.file} download>Scarica</a>}
              {c.data.link_esterno && <a href={c.data.link_esterno}>Apri</a>}
            </div>
          </li>
        ))}
      </ul>
    )
  }
</MainLayout>
