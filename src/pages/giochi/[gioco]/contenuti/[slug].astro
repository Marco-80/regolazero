---
import { getCollection, render } from 'astro:content';
import MainLayout from '../../../../layouts/MainLayout.astro';
import { isPubblicatoContenuto } from '../../../../lib/articoli';

export async function getStaticPaths() {
  const contenuti = await getCollection('contenuti', isPubblicatoContenuto);
  return contenuti
    .filter((c) => c.data.gioco)
    .map((c) => ({
      params: { gioco: c.data.gioco!, slug: c.id },
      props: { contenuto: c },
    }));
}

const { contenuto } = Astro.props;
const d = contenuto.data;
const { Content } = await render(contenuto);
---

<MainLayout titolo={d.titolo} descrizione={d.estratto}>
  <p><a href={`/giochi/${d.gioco}/contenuti/`}>← Contenuti</a></p>
  <h1>{d.titolo}</h1>
  <p style="color: var(--rz-muted);">{d.tipo}</p>
  <p>{d.estratto}</p>

  {d.file && <p><a href={d.file} download>Scarica il file</a></p>}
  {d.link_esterno && <p><a href={d.link_esterno}>Apri risorsa esterna</a></p>}

  <div class="rz-prose"><Content /></div>
</MainLayout>
