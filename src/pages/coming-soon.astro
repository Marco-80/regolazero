---
import LoginTriangle from '../components/LoginTriangle.astro';
const canonical = new URL('/coming-soon/', Astro.site).href;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>RegolaZero — In arrivo</title>
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <style>
      /* Sfondo scuro fisso (non segue il tema chiaro/scuro del sistema):
         serve perché il logo è bianco su trasparente. */
      body {
        margin: 0;
        min-height: 100svh;
        display: grid;
        place-items: center;
        background: #121212;
        color: #cfcfcf;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        text-align: center;
        padding: 2rem 1.25rem;
        box-sizing: border-box;
      }
      .logo {
        width: min(90vw, 32rem);
        height: auto;
      }
      p {
        margin-top: 2rem;
        font-size: 1.1rem;
        color: #9c9c9c;
      }
    </style>
  </head>
  <body>
    <div>
      <img
        class="logo"
        src="/images/site/logo-regolazero.png"
        alt="RegolaZero"
        width="1600"
        height="656"
      />
      <p>Il sito è in costruzione. Torna presto.</p>
    </div>
    <LoginTriangle />
  </body>
</html>
