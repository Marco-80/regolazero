---
import MainLayout from '../../layouts/MainLayout.astro';
import CardArticolo from '../../components/main/CardArticolo.astro';
import { articoliPubblicati } from '../../lib/articoli';

const articoli = await articoliPubblicati();
const tipi = [...new Set(articoli.map((a) => a.data.tipo))].sort();
---

<MainLayout titolo="Articoli" descrizione="Novità, diari di sviluppo e approfondimenti di RegolaZero.">
  <div class="rz-page-hero">
    <h1>Articoli</h1>
    <p>Novità, diari di sviluppo, recensioni e approfondimenti da RegolaZero.</p>
  </div>

  {
    tipi.length > 0 && (
      <nav class="rz-pills" aria-label="Filtra per tipo" id="rz-filtro-tipi">
        <button type="button" class="rz-pill" data-tipo="" aria-current="true">Tutti</button>
        {tipi.map((t) => (
          <button type="button" class="rz-pill" data-tipo={t}>{t}</button>
        ))}
      </nav>
    )
  }

  {
    articoli.length === 0 ? (
      <p><em>Presto in arrivo.</em></p>
    ) : (
      <div class="rz-grid" id="rz-lista-articoli">
        {articoli.map((a) => (
          <div data-tipo={a.data.tipo}>
            <CardArticolo articolo={a} />
          </div>
        ))}
      </div>
    )
  }
</MainLayout>

<script>
  // Filtro istantaneo per tipo, senza ricaricare la pagina.
  const nav = document.getElementById('rz-filtro-tipi');
  const lista = document.getElementById('rz-lista-articoli');
  if (nav && lista) {
    const pills = Array.from(nav.querySelectorAll<HTMLButtonElement>('.rz-pill'));
    const voci = Array.from(lista.children) as HTMLElement[];

    function applica(tipo: string) {
      for (const v of voci) {
        v.hidden = Boolean(tipo) && v.dataset.tipo !== tipo;
      }
      for (const p of pills) {
        p.setAttribute('aria-current', String(p.dataset.tipo === tipo));
      }
      const url = new URL(location.href);
      if (tipo) url.searchParams.set('tipo', tipo);
      else url.searchParams.delete('tipo');
      history.replaceState(null, '', url);
    }

    nav.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.rz-pill');
      if (btn) applica(btn.dataset.tipo ?? '');
    });

    const iniziale = new URL(location.href).searchParams.get('tipo') ?? '';
    applica(iniziale);
  }
</script>
