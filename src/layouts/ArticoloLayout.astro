---
import MainLayout from './MainLayout.astro';
import type { CollectionEntry } from 'astro:content';
import { copertinaEsiste } from '../lib/img';

interface Props {
  articolo: CollectionEntry<'articoli'>;
}
const { articolo } = Astro.props;
const d = articolo.data;
const fmt = new Intl.DateTimeFormat('it-IT', { dateStyle: 'long' });
const haCopertina = copertinaEsiste(d.copertina);
---

<MainLayout titolo={d.titolo} descrizione={d.estratto}>
  <article>
    {
      haCopertina && (
        <div class="rz-article-cover">
          <img src={d.copertina} alt="" />
        </div>
      )
    }

    <h1 style="margin-top: 0;">{d.titolo}</h1>
    <p style="color: var(--rz-muted); font-size: 0.85rem; margin-bottom: 1.5rem;">
      {fmt.format(d.data)} · {d.tipo} · {d.autore}
      {d.gioco && <> · <a href={`/giochi/${d.gioco}/`}>{d.gioco}</a></>}
    </p>

    <div class="rz-prose">
      <slot />
    </div>

    {
      d.tag.length > 0 && (
        <p style="color: var(--rz-muted); font-size: 0.85rem; margin-top: 2rem;">
          Tag: {d.tag.join(' · ')}
        </p>
      )
    }
  </article>
</MainLayout>
