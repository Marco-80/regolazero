# Copia in .env (git-ignorato). Le variabili PUBLIC_* sono esposte al client.

# Endpoint del Worker che raccoglie le iscrizioni alla mailing list (§7.5).
# Se vuoto, la pagina /the-mist/mailing-list/ mostra un fallback mailto.
PUBLIC_MAILINGLIST_ENDPOINT=

# Email mostrata nel fallback quando l'endpoint non è configurato.
PUBLIC_MAILINGLIST_FALLBACK_EMAIL=info@regolazero.it
